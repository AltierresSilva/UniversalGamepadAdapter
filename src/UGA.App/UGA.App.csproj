<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UniversalGamepadAdapter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UGA.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../UGA.Infrastructure/UGA.Infrastructure.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\UGA.ico" LogicalName="UGA.BrandIcon" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\UGA-brand.png" LogicalName="UGA.BrandImage" /></ItemGroup>
</Project>
